# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model for advisor/orchestrator helpers
# Default in code is gpt-5
OPENAI_MODEL=gpt-5

# Geoapify API Key (used by WebSearchAPI, MapsAPI, ReviewsAPI)
# Get your key from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Debug Mode
# Set to "true" to see the ReAct thought process of agents
# Shows: Thoughts, Actions, Tool calls, Observations, and Coordinator decisions
# Default: false
DEBUG=true
